# 复制为 .env.local 后填写。密钥只放本机 .env.local，生产放仓库外的 MAPLETOOLS_ENV_FILE，不要提交

# ── 必填：AI（DeepSeek，OpenAI 兼容）──────────────
AI_API_KEY=sk-your-key-here

# ── 可选：登录方式（两项都填才显示对应入口）────────
# 回调地址统一为 <站点地址>/api/auth/oauth/<github|google|linuxdo>/callback，开发与生产各建一个应用
# GitHub：https://github.com/settings/developers
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# Google：https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# LinuxDO：https://connect.linux.do
# LINUXDO_CLIENT_ID=
# LINUXDO_CLIENT_SECRET=

# ── 可选：反馈管理 ────────────────────────────────
# 二选一即可，都留空则无人有管理权限
# 管理员的用户 ID：登录后在「设置 → 个人资料」里能看到，多个用逗号隔开
# FEEDBACK_ADMIN_USER_IDS=
# 或填管理员账号已验证的邮箱
# FEEDBACK_ADMIN_EMAIL=
# 新反馈的通知收件邮箱
# FEEDBACK_NOTIFY_TO=

# ── 可选：AI 高级（默认值即可）────────────────────
# AI_BASE_URL=https://api.deepseek.com
# AI_MODEL=deepseek-flash
# 不填则配了 AI_API_KEY 就开启；填 0 可强制关闭所有 AI 功能，填 1 强制开启
# AGENT_AI_ENABLED=
# 每日花费上限（美元），超出后暂停 AI；不填用保守默认值
# AGENT_LIMITS_JSON={"globalDailyCost":1,"userDailyCost":0.1}

# ── 部署到服务器时额外配置（本地开发不用管）─────────
# 密钥放哪：把上面的密钥写进仓库外的一个文件（如 /opt/mapletools-data/.env.ai），这里填它的路径，部署重传代码时密钥不会丢
# MAPLETOOLS_ENV_FILE=/opt/mapletools-data/.env.ai
# 前面有 nginx 反代时填 1，访客限流才能认出真实 IP；nginx 里要有 proxy_set_header X-Real-IP $remote_addr; 没有反代别填
# AGENT_TRUST_LOOPBACK_PROXY=1
# AI 单次回答最长多少字（token），范围 256~8192，不填 8192；想省钱就调小
# AGENT_ANSWER_OUTPUT_TOKENS=8192
# 允许用户自带 key（BYOK）时可用的模型清单；默认只放行 DeepSeek，要放行别家才填（字段说明见 README）
# AGENT_BYOK_PROFILES=[{"endpoint":"https://provider.example/v1","model":"reviewed-model","contextTokens":64000,"maxOutputTokens":8192,"price":{"currency":"USD","version":"reviewed-date","inputPerMillion":1,"cachedInputPerMillion":1,"outputPerMillion":3}}]
# 想把站点 AI 换成更强的模型时，要在这里留一条"已评测通过"的批准记录；平时不用填（字段说明见 README）
# AGENT_MODEL_APPROVAL={"model":"approved-stronger-model","baselineEvaluationId":"evaluation-id","baselinePassed":false,"strongerModelVerified":true,"approvedBy":"maintainer","approvedAt":1788825600000}
