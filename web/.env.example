# 本地开发用的服务器 AI API Key（DeepSeek，OpenAI 兼容）。只在本机 .env.local 填写。
# 生产请把 key 放在仓库外的 MAPLETOOLS_ENV_FILE，不要把 .env 上传到 web/。
AI_API_KEY=sk-your-key-here
# 可选：覆盖默认 base_url / model
# AI_BASE_URL=https://api.deepseek.com
# AI_MODEL=deepseek-v4-flash-vision-exp
# 生产由 PM2 指向仓库外的密钥文件；本地一般不设置
# MAPLETOOLS_ENV_FILE=/opt/mapletools-data/.env.ai

# 配好 AI_API_KEY 后正常 npm run dev 即可；页面后台探测（可能计费），发送复用连接；仍受配额与预算限制。
# 管理员需要关闭所有 Agent AI（含 BYOK）时显式设置：
# AGENT_AI_ENABLED=0
# USD；省略字段使用此保守默认值；所有阈值均须大于零。
# AGENT_LIMITS_JSON={"globalDailyCost":1,"userDailyCost":0.1,"guestDailyCost":0.02,"turnCost":0.03,"guestTurnCost":0.01,"warningCost":0.005,"userTurns":30,"guestTurns":10,"concurrency":2,"dailyTokens":1000000,"turnTokens":256000}
# 只有 node 绑定回环 + nginx 覆写 X-Real-IP 时启用。默认忽略转发头。
# AGENT_TRUST_LOOPBACK_PROXY=1
# 默认 BYOK 仅允许 api.deepseek.com 的基线模型。扩展由维护者核对域名、型号、窗口和 USD 单价；不填写密钥。
# AGENT_BYOK_PROFILES=[{"endpoint":"https://provider.example/v1","model":"reviewed-model","contextTokens":64000,"maxOutputTokens":8192,"price":{"currency":"USD","version":"reviewed-date","inputPerMillion":1,"cachedInputPerMillion":1,"outputPerMillion":3}}]
# 更强服务器模型还须审批记录；不自动降档。对应模型也须在已核准 profiles 中。
# AGENT_MODEL_APPROVAL={"model":"approved-stronger-model","baselineEvaluationId":"evaluation-id","baselinePassed":false,"strongerModelVerified":true,"approvedBy":"maintainer","approvedAt":1788825600000}
# 单次回答输出预留，可在 256~8192 之间配置；访客仍至多 2048。
# AGENT_ANSWER_OUTPUT_TOKENS=8192
# 本地固定 DeepSeek 域名自动兼容 Fake-IP；生产及其他 BYOK 域名仍执行公网地址检查。
