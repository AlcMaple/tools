{
  "name": "mapletools-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "@hono/vite-dev-server": {
      "@hono/node-server": "^2.1.0"
    }
  },
  "scripts": {
    "dev": "npm run build:agent-release && vite",
    "build": "npm run build:agent-release && vite build && tsx scripts/build-player-monitor.ts",
    "preview": "vite preview",
    "start": "tsx server/node.ts",
    "sync:index": "tsx scripts/build-bgm-index.ts",
    "test:agent-contract": "tsx scripts/test-agent-contract.ts",
    "test:agent-history": "tsx scripts/test-agent-history.ts",
    "test:agent-context": "tsx scripts/test-agent-context.ts",
    "test:agent-loop": "npm run build:agent-release && tsx scripts/test-agent-loop.ts",
    "test:agent-tracks": "npm run build:agent-release && tsx scripts/test-agent-tracks.ts",
    "test:agent-playback": "npm run build:agent-release && tsx scripts/test-agent-playback.ts",
    "sync:agent-guide": "tsx scripts/sync-agent-feature-docs.ts",
    "test:agent-data": "npm run build && tsx scripts/test-agent-data.ts",
    "build:agent-release": "tsx scripts/build-agent-release.ts",
    "test:agent-ui": "npm run build && tsx scripts/test-agent-ui.ts",
    "test:agent-ui:serve": "npm run build && tsx scripts/agent-ui-fixture.ts",
    "test:agent-external": "npm run build:agent-release && tsx scripts/test-agent-external.ts && tsx scripts/test-agent-connections.ts",
    "test:agent-experience": "tsx scripts/test-agent-experience.ts",
    "test:prepare-regions": "tsx scripts/test-prepare-regions.ts",
    "test:agent-sources": "npm run build && tsx scripts/test-agent-sources.ts && tsx scripts/test-agent-source-budget.ts"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fontsource/space-grotesk": "^5.2.10",
    "@hono/node-server": "^2.1.0",
    "@sentry/browser": "^10.71.0",
    "@sentry/node": "^10.71.0",
    "@sentry/react": "^10.71.0",
    "better-sqlite3": "^12.11.1",
    "cheerio": "^1.2.0",
    "hls.js": "^1.6.16",
    "hono": "^4.13.1",
    "nodemailer": "^9.0.5",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "undici": "^6.28.0"
  },
  "devDependencies": {
    "@hono/vite-dev-server": "^0.26.1",
    "@sentry/vite-plugin": "^5.4.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/nodemailer": "^7.0.12",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.1",
    "typescript": "^5.6.3",
    "vite": "^6.4.3"
  }
}
